{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthResponse",
  "description": "JSON Schema contract for GET /health and GET /api/v1/health response",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "error",
        "warming_up",
        "starting"
      ],
      "description": "Kernel health status (starting = repo map still building)"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic version of Tylluan Kernel"
    },
    "commit": {
      "type": "string",
      "minLength": 7,
      "description": "Git commit SHA baked at build time"
    },
    "repo_map": {
      "type": "string",
      "enum": [
        "building",
        "ok",
        "failed"
      ],
      "description": "Repo map sub-state (D-39); building while the background build runs"
    },
    "sentinel": {
      "type": "object",
      "description": "T-DSH-113: centinela de write_gate L2 (sin tokens ni rutas)",
      "properties": {
        "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
        "loaded": { "type": "boolean" },
        "verdicts": {
          "type": "object",
          "properties": {
            "safe": { "type": "integer", "minimum": 0 },
            "controversial": { "type": "integer", "minimum": 0 },
            "unsafe": { "type": "integer", "minimum": 0 },
            "unavailable": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "fallbacks": { "type": "integer", "minimum": 0 },
        "in_flight": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "version",
    "commit"
  ],
  "additionalProperties": false
}
