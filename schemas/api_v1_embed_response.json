{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmbedResponse",
  "description": "JSON Schema contract for POST /api/v1/embed successful response",
  "type": "object",
  "properties": {
    "embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "description": "L2-normalized dense vector embedding"
    },
    "dimension": {
      "type": "integer",
      "minimum": 1,
      "description": "Dimension of the dense vector (e.g. 1024 for BGE-M3)"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model identifier used for vectorization (e.g. 'bge-m3')"
    }
  },
  "required": [
    "embedding",
    "dimension",
    "model"
  ],
  "additionalProperties": false
}
